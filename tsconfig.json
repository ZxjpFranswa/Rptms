{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "baseUrl": "."
  },
  "include": ["src", "server/types.d.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}

